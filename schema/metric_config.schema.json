{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "经营指标查询与分析 Bot 配置模板",
  "type": "object",
  "required": [
    "metric_id", "name", "category", "definition",
    "calculation_type", "data_input_schema", "output_kind"
  ],
  "additionalProperties": false,
  "properties": {
    "metric_id": {
      "type": "string",
      "pattern": "^metric-[a-z][a-z0-9-]{2,47}$",
      "description": "指标唯一 ID"
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "category": {
      "type": "string",
      "enum": ["revenue", "cost", "customers", "operations",
               "quality", "finance"]
    },
    "definition": { "type": "string", "minLength": 10, "maxLength": 300 },
    "calculation_type": {
      "type": "string",
      "enum": ["sum", "average", "ratio", "count", "delta", "custom"],
      "description": "计算方式（对应验收：计算校验）"
    },
    "data_input_schema": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "string", "minLength": 1 },
        "group_by": { "type": "string" },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "output_kind": {
      "type": "string",
      "enum": ["fact", "calculation", "suggestion"],
      "description": "区分事实/计算/建议（验收核心）"
    },
    "formula": { "type": "string", "minLength": 2 },
    "suggestion_rule": { "type": "string", "minLength": 5 },
    "anonymized_note": { "type": "string", "minLength": 5 }
  }
}